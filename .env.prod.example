# SOPA Backend - Production Environment Configuration
# Copy this file to .env.prod and configure with your production values
# SECURITY: Change these values in production!

# Primary Database Configuration - Neon Cloud Database
# This is your main production database (replace with your actual Neon URL)
DATABASE_URL="postgresql://username:password@your-neon-host:5432/your_database?sslmode=require"

# Secondary Neon Database for data synchronization (if different from primary)
# If using the same database, set this to the same value as DATABASE_URL
NEON_DATABASE_URL="postgresql://username:password@your-neon-host:5432/your_database?sslmode=require"

# Redis Configuration - Use your production Redis
REDIS_URL="redis://redis:6379"
REDIS_PASSWORD=your_redis_password_here

# Application Settings
ENVIRONMENT="production"
PROJECT_NAME="SOPA API - Production"
DEBUG=false
LOG_LEVEL="info"
API_PORT=8000

# CORS Settings - Configure for your production domains
ALLOWED_HOSTS="yourdomain.com,www.yourdomain.com,api.yourdomain.com"

# Rate Limiting - Adjust for production load
RATE_LIMIT_PER_MINUTE=60

# Security Settings (add any additional production-specific settings)
# API_KEY_SECRET="your-secret-key"
# JWT_SECRET="your-jwt-secret"
